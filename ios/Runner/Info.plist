<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>RadioApp</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>radio_app</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Deep links: radioapp://article?id=X  /  radioapp://podcast?id=X -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>radioapp</string>
				</array>
				<key>CFBundleURLName</key>
				<string>com.neuscampos.radioapp</string>
			</dict>
		</array>
		<!-- audio_service: reproducción en segundo plano + pantalla del coche (CarPlay / Bluetooth) -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Firebase Analytics: desactivado por defecto hasta consentimiento RGPD (equivalente al meta-data del AndroidManifest) -->
		<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
		<false/>
		<!-- ITMS-90683: las librerías de audio (audio_session/just_audio) referencian la
	     API del micrófono aunque la app NO graba. Apple exige la cadena igualmente. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>RadioApp does not record audio. This permission is only referenced by the audio playback libraries and the microphone is never accessed.</string>
		<!-- La app no usa cifrado no exento (solo HTTPS estándar) → evita la pregunta de Export Compliance en cada build. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- ATS: permite HTTP para el stream de vídeo en directo (puerto 8888) -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
			<key>NSExceptionDomains</key>
			<dict>
				<key>streaming.unicaradio.it</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
					<key>NSIncludesSubdomains</key>
					<false/>
				</dict>
			</dict>
		</dict>
	</dict>
</plist>
